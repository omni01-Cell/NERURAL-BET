{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin HEAD)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(python -m pytest*)",
      "Bash(python -m ruff *)",
      "Bash(python -m build*)",
      "Bash(uv pip install *)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push * master*)",
      "Bash(git push *:master*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git config *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh release *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Edit(/.github/**)",
      "Edit(/.githooks/**)",
      "Edit(/.gouvernance/**)",
      "Edit(/.GCC/PROTOCOL.md)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.codex/**)",
      "Edit(/.claude/**)",
      "Edit(/.agents/**)",
      "Edit(/.coding-stuff/**)",
      "Edit(/scripts/setup_workspace.py)",
      "Edit(/scripts/quality_gate.py)",
      "Edit(/scripts/start_codex.py)",
      "Edit(/scripts/apply_antigravity_permissions.py)",
      "Edit(/.git/**)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(~/.codex/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.gemini/**)",
      "Edit(//Users/OmniM/AppData/Local/Programs/antigravity/**)",
      "Edit(//Users/OmniM/AppData/Local/Programs/Antigravity IDE/**)",
      "Edit(//Users/OmniM/AppData/Local/OpenAI/Codex/**)"
    ]
  }
}
