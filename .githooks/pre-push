#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
count=0
while read -r local_ref local_sha remote_ref remote_sha; do
    count=$((count + 1))
    [ "$count" -le 1000 ] || { echo 'Trop de références dans un envoi.' >&2; exit 1; }
    case "$remote_ref" in
        refs/heads/main|refs/heads/master|refs/tags/*)
            echo 'Envoi interdit : publier une branche de travail et ouvrir une pull request.' >&2; exit 1 ;;
    esac
    case "$local_sha" in 0000000000000000000000000000000000000000)
        echo 'Suppression distante interdite depuis un agent.' >&2; exit 1 ;;
    esac
    if [ "$remote_sha" != 0000000000000000000000000000000000000000 ]; then
        git merge-base --is-ancestor "$remote_sha" "$local_sha" || {
            echo 'Réécriture distante interdite : synchroniser la branche sans forcer.' >&2; exit 1;
        }
    fi
done
if [ -x .venv/Scripts/python.exe ]; then py=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then py=.venv/bin/python
else py=python3; fi
"$py" -m pytest tests/unit -q
QUALITY_GATE_SCOPE=full .githooks/pre-commit
